# Core / team workspace
GUIDE_AGENT_ADMIN_USERNAME="admin"
GUIDE_AGENT_ADMIN_PASSWORD="change-me-now"
ACCOUNT_SYNC_TOKEN="replace-with-a-long-random-account-sync-token"
GUIDE_AGENT_SESSION_SECRET="replace-with-a-long-random-session-secret"
GUIDE_AGENT_PUBLIC_BASE_URL="http://localhost:8080"

# Independent RAG database
GUIDE_AGENT_POSTGRES_USER="guide-agent"
GUIDE_AGENT_POSTGRES_PASSWORD="replace-with-a-long-random-password"
GUIDE_AGENT_POSTGRES_DB="guide-agent"
RAG_BOOTSTRAP_API_KEY="ga_live_bootstrap_replace-with-a-long-random-secret"

# Embeddings. The endpoint must support the OpenAI-compatible /v1/embeddings API.
EMBEDDING_PROVIDER="openai"
EMBEDDING_BASE_URL="http://host.docker.internal:11434/v1"
EMBEDDING_API_KEY="replace-with-embedding-api-key"
EMBEDDING_MODEL="replace-with-embedding-model"
EMBEDDING_DIMENSION="1024"

# Chat model. The default example uses DeepSeek's OpenAI-compatible API.
CHAT_BASE_URL="https://api.deepseek.com"
CHAT_API_KEY="replace-with-deepseek-api-key"
CHAT_MODEL="deepseek-flash"
CHAT_THINKING="enabled"
CHAT_REASONING_EFFORT="low"
CHAT_FALLBACK_BASE_URL=""
CHAT_FALLBACK_API_KEY=""
CHAT_FALLBACK_MODEL=""

# Agent kernel and cache
PROMPT_VERSION="v1"
GUIDE_AGENT_SITE_ID="default-site"
TOOL_CONFIG_PATH="tool_configure.json"
TOOL_TIMEOUT_SECONDS="20"
TOOL_MAX_RESULT_CHARS="8192"
AGENT_MAX_TOOL_ROUNDS="10"
AGENT_MAX_CONSECUTIVE_TOOL_ERRORS="3"
PAGE_CACHE_RETENTION_DAYS="90"
CHAT_RATE_LIMIT_PER_MINUTE="30"
PAGE_CACHE_RATE_LIMIT_PER_MINUTE="60"

# Website read-only export. Keep the token separate from website credentials.
WEBSITE_EXPORT_BASE_URL="http://app:3000"
WEBSITE_EXPORT_TOKEN="replace-with-the-website-agent-export-token"
WEBSITE_SYNC_ENABLED="false"
WEBSITE_SYNC_INTERVAL_SECONDS="300"
WEBSITE_MANIFEST_INTERVAL_SECONDS="43200"

# Direct read-only website database and gated draft writes.
WEBSITE_READONLY_DATABASE_URL="postgresql://guide_agent_readonly:replace-with-readonly-password@website-postgres:5432/blog"
WEBSITE_WRITE_BASE_URL="http://web-nginx-1/api/agent-write/v1"
WEBSITE_WRITE_ADMIN_TOKEN="replace-with-agent-write-admin-token"
WEBSITE_WRITE_SESSION_DEFAULT_MINUTES="30"
WEBSITE_WRITE_SESSION_MAX_MINUTES="60"

# Website content downloads through the team workspace.
WEBSITE_DOWNLOAD_LIMIT_MBPS="10"
WEBSITE_DOWNLOAD_BURST_SECONDS="0.1"

# Optional web search adapter. Leave empty to keep external search disabled.
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""
WEB_SEARCH_BASE_URL=""

# Retention and limits
CONVERSATION_RETENTION_DAYS="90"
MAX_UPLOAD_BYTES="52428800"
